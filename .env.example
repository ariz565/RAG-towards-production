# ═══════════════════════════════════════════════════════════
#  Vision — Environment Configuration
#  Reasoning-grounded, multi-tenant agentic RAG platform
# ═══════════════════════════════════════════════════════════

# ── Active Switches ──────────────────────────────────────
# Model: openai | azure_openai | openrouter | groq | gemini | ollama
ACTIVE_MODEL=ollama

# Retrieval: pageindex | hybrid | bm25_only | vector_only
ACTIVE_RETRIEVAL=hybrid

# Embeddings: huggingface | openai
ACTIVE_EMBEDDING=huggingface

# ── LLM Providers ───────────────────────────────────────
# OpenAI (optional — only needed if ACTIVE_MODEL=openai)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Azure OpenAI (optional — only needed if ACTIVE_MODEL=azure_openai)
AZURE_OPENAI_API_KEY=your-azure-openai-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# OpenRouter (optional — only needed if ACTIVE_MODEL=openrouter)
OPENROUTER_API_KEY=your-openrouter-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# Groq (optional — only needed if ACTIVE_MODEL=groq)
GROQ_API_KEY=your-groq-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
# NVIDIA (optional — only needed if ACTIVE_MODEL=nvidia)
NVIDIA_API_KEY=your-nvidia-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=deepseek-ai/deepseek-v4-pro
# Google Gemini (optional — only needed if ACTIVE_MODEL=gemini)
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-2.0-flash

# Ollama (free, local — default)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ── Embeddings ──────────────────────────────────────────
# HuggingFace (free, local — default)
HF_EMBEDDING_MODEL=all-MiniLM-L6-v2
HF_EMBEDDING_DIM=384

# ── Qdrant Vector Store ────────────────────────────────
# in_memory=false → persistent local storage at QDRANT_PATH (survives restarts,
# no re-embed on boot). use_server=true → connect to QDRANT_HOST:QDRANT_PORT.
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=vision
QDRANT_IN_MEMORY=false
QDRANT_USE_SERVER=false
QDRANT_PATH=data/qdrant

# ── Multi-tenancy (Phase C) ────────────────────────────
DEFAULT_TENANT=default

# ── Query understanding (classify → normalize → rewrite) ─
QUERY_UNDERSTANDING_ENABLED=true
QUERY_REWRITE_ENABLED=true

# ── Document routing (multi-doc Q&A within a tenant) ────
ROUTER_ENABLED=true
ROUTER_MIN_SCORE=0.15

# ── Summarization (map-reduce) ─────────────────────────
SUMMARIZE_MAX_MAP_CALLS=200
SUMMARIZE_MAX_CONCURRENCY=6

# ── Storage (pluggable: local now, s3 later) ───────────
STORAGE_BACKEND=local

# ── Auth (signup/login + signed bearer tokens) ─────────
# CHANGE auth_secret in production (use a secret manager); rotate to invalidate tokens.
AUTH_SECRET=dev-secret-change-me
AUTH_TOKEN_TTL_SECONDS=86400
USERS_DB_PATH=data/users.json

# ── Durable execution — LangGraph checkpointer (Phase C) ──
# "sqlite" = resume-after-crash; "memory" = ephemeral.
CHECKPOINTER=sqlite
CHECKPOINT_DB_PATH=data/checkpoints.sqlite

# ── Observability — OpenTelemetry GenAI semconv (Phase D) ──
# Disabled → spans are no-ops. Point the OTLP endpoint at Langfuse/Datadog/etc.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=vision
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_CONSOLE_EXPORT=false
OTEL_CAPTURE_CONTENT=false

# ── Chunking ───────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=100

# ── Hybrid Retrieval ──────────────────────────────────
HYBRID_TOP_K=10
BM25_TOP_K=20
VECTOR_TOP_K=20
RRF_K=60

# ── Grounding / Verification (Phase B) ────────────────
GROUNDING_MAX_CONTEXT_CHARS=12000
GROUNDING_ACCEPT_THRESHOLD=0.6
GROUNDING_REFUSE_THRESHOLD=0.5

# ── Reranking (Phase B) ────────────────────────────────
RERANK_ENABLED=true
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATES=30      # candidate pool retrieved AND scored by the reranker
RERANK_TOP_K=6            # kept after rerank (final context size)

# ── MMR Diversity (opt-in) ─────────────────────────────
# Re-select the final candidates to cut redundancy. λ: 1.0=relevance, 0.0=diversity.
MMR_ENABLED=false
MMR_LAMBDA=0.6

# ── Query-embedding cache ──────────────────────────────
# Avoids re-embedding the same query (router + vector search + retries).
EMBEDDING_CACHE_ENABLED=true
EMBEDDING_CACHE_SIZE=2048

# ── PageIndex navigation (vectorless, reasoning-based retrieval) ──
# Small trees → single LLM call; large trees → hierarchical level-by-level descent.
PAGEINDEX_TREE_CHAR_BUDGET=12000
PAGEINDEX_MAX_DEPTH=4
PAGEINDEX_MAX_SELECT_NODES=6
PAGEINDEX_MAX_PAGES=12
PAGEINDEX_PASSAGE_CHARS=1200
PAGEINDEX_REPAIR_NAVIGATION=true
PAGEINDEX_PRESERVE_READING_ORDER=true

# ── Contextual Retrieval (Phase B, opt-in — needs re-index) ──
CONTEXTUAL_RETRIEVAL_ENABLED=false
CONTEXTUAL_DOC_SAMPLE_CHARS=4000
CONTEXTUAL_MAX_CONCURRENCY=8

# ── Evaluation (Phase A) ───────────────────────────────
# Judge defaults to ACTIVE_MODEL; a hosted judge gives more reliable scores.
EVAL_JUDGE_PROVIDER=
EVAL_JUDGE_MODEL=
EVAL_FAITHFULNESS_THRESHOLD=0.75
EVAL_ANSWER_RELEVANCY_THRESHOLD=0.80
EVAL_CONTEXT_PRECISION_THRESHOLD=0.70
EVAL_CONTEXT_RECALL_THRESHOLD=0.80

# ── Domain Profile (document-agnostic) ─────────────────
AUTO_GENERATE_PROFILE=true
DOMAIN_DESCRIPTION_OVERRIDE=
DOMAIN_PERSONA_OVERRIDE=

# ── General ────────────────────────────────────────────
TEMPERATURE=0

# ── LLM resilience (timeouts + retry policy) ───────────
# Retries ONLY transient errors (408/425/429/5xx, timeouts, connection errors)
# with exponential backoff + full jitter, honoring Retry-After. 4xx fail fast.
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY=0.5
LLM_RETRY_MAX_DELAY=20
LLM_RETRY_JITTER=true
LLM_RETRY_RESPECT_RETRY_AFTER=true

# ── Answer / reranker budgets ──────────────────────────
ANSWER_MAX_CONTEXT_CHARS=12000
RERANK_MAX_CHARS=2400

# ── Safety guardrails ──────────────────────────────────
# Input: block prompt-injection/jailbreak queries. Output: redact PII.
INJECTION_GUARD_ENABLED=true
PII_REDACTION_ENABLED=true

# ── AI Governance (audit trail, document lineage, risk tiering) ──
# risk tier: "standard" | "high" (high → stricter grounding + citations required).
GOVERNANCE_RISK_TIER=standard
AUDIT_ENABLED=true
AUDIT_DIR=data/audit
AUDIT_LOG_QUERY_TEXT=true     # false → store only a hash of the query (max privacy)
AUDIT_RETENTION_DAYS=90
LINEAGE_ENABLED=true

# ── Agentic depth (Phase E) — opt-in, off by default ───
# HITL: pause on ambiguous questions, resume via POST /api/ask/resume.
# Corrective-RAG: grade retrieved context and re-retrieve if too weak.
HITL_ENABLED=false
CORRECTIVE_RAG_ENABLED=false
CORRECTIVE_GRADE_THRESHOLD=0.6

# ── Ollama embeddings (if ACTIVE_EMBEDDING=ollama) ─────
OLLAMA_EMBEDDING_DIM=768

# ── Paths (relative to project root) ──────────────────
PDF_DIR=data/pdf
INDEX_DIR=data/index
BM25_DIR=data/bm25
CHUNKS_DIR=data/chunks

# ── Server ─────────────────────────────────────────────
HOST=0.0.0.0
PORT=8001

# ── Frontend CORS ──────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8501"]
